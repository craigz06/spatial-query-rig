{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(python:*)",
      "Bash(python3:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "Bash(trash:*)",
      "Bash(unlink:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.ENV)",
      "Read(**/.ENV.*)",
      "Read(**/.Env)",
      "Read(**/.Env.*)",
      "Read(**/*key*)",
      "Read(**/*Key*)",
      "Read(**/*KEY*)",
      "Read(**/*secret*)",
      "Read(**/*Secret*)",
      "Read(**/*SECRET*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.ENV)",
      "Edit(**/.ENV.*)",
      "Edit(**/.Env)",
      "Edit(**/.Env.*)",
      "Edit(**/*key*)",
      "Edit(**/*Key*)",
      "Edit(**/*KEY*)",
      "Edit(**/*secret*)",
      "Edit(**/*Secret*)",
      "Edit(**/*SECRET*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/.ENV)",
      "Write(**/.ENV.*)",
      "Write(**/.Env)",
      "Write(**/.Env.*)",
      "Write(**/*key*)",
      "Write(**/*Key*)",
      "Write(**/*KEY*)",
      "Write(**/*secret*)",
      "Write(**/*Secret*)",
      "Write(**/*SECRET*)"
    ]
  }
}
